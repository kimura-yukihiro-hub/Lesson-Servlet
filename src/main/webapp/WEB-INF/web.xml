<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://w3.org" 
         xmlns="https://jakarta.ee" 
         xsi:schemaLocation="https://jakarta.ee https://jakarta.ee/web-app_6_0.xsd" 
         id="WebApp_ID" 
         version="6.0">
<filter>
	<filter-name>CharacterEncodingFilter</filter-name>
	<filter-class>chapter10.CharacterEncodingFilter</filter-class>
</filter>

<filter>
	<filter-name>AuthFilter</filter-name>
	<filter-class>chapter10.AuthFilter</filter-class>
</filter>

<filter-mapping>
	<filter-name>CharacterEncodingFilter</filter-name>
	<url-pattern>/*</url-pattern>
</filter-mapping>

<filter-mapping>
	<filter-name>AuthFilter</filter-name>
	<url-pattern>/secure/*</url-pattern>
</filter-mapping>

</web-app>